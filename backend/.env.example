# Persistencia: postgres (docker compose up -d db) o memory (demo sin BD)
STORAGE=postgres
DATABASE_URL=postgresql+psycopg://muevete:muevete@localhost:5432/muevete
# Sal para anonimizar ids de canal (teléfonos, chat ids). Cámbiala y no la publiques.
ID_SALT=cambia-este-salt

# Rol admin: quien envíe este valor en X-Admin-Key
ADMIN_API_KEY=

# LLM para pulir respuestas: gemini | none
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
LLM_TIMEOUT_S=4

CORS_ORIGINS=*

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
