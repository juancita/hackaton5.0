# Persistencia: postgres (docker compose up -d db) o memory (demo sin BD)
STORAGE=postgres
DATABASE_URL=postgresql+psycopg://muevete:muevete@localhost:5432/muevete
# Sal para anonimizar ids de canal (teléfonos, chat ids). Cámbiala y no la publiques.
ID_SALT=cambia-este-salt

# Rol admin: quien envíe este valor en X-Admin-Key
ADMIN_API_KEY=

# LLM (entender texto libre + pulir respuestas): gemini | none
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Respaldo si el principal no responde en GEMINI_PRIMARY_TIMEOUT_S segundos o falla (vacío = sin respaldo)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_PRIMARY_TIMEOUT_S=6
# Nivel de razonamiento: minimal | low | medium | high (vacío = el del modelo)
GEMINI_THINKING=minimal
LLM_TIMEOUT_S=12

CORS_ORIGINS=*

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
