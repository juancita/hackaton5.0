# Variables para docker compose (cópialo a .env en la raíz; .env NO se sube al repo).
# Todo tiene valores por defecto: con este archivo tal cual el proyecto arranca.

# --- Puertos publicados en la máquina anfitriona ---
WEB_PORT=80          # web:     http://localhost
API_PORT=8080        # backend: http://localhost:8080 (docs en /docs). Déjalo en 8080: el front lo busca ahí si WEB_PORT no es 80
PG_PORT=5432         # PostgreSQL para clientes externos (DBeaver, pytest -m pg)

# --- Base de datos ---
POSTGRES_USER=muevete
POSTGRES_PASSWORD=muevete
POSTGRES_DB=muevete

# --- Backend ---
ID_SALT=cambia-este-salt     # sal para anonimizar teléfonos / chat ids
ADMIN_API_KEY=               # quien la envíe en X-Admin-Key es admin (vacío = sin admin)
CORS_ORIGINS=*
PUBLIC_BASE_URL=             # URL pública del backend (para que Telegram/WhatsApp descarguen mapas)

# LLM opcional: gemini | none
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Canales opcionales
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
